# ==============================================================================
# Mahjar Parents Frontend — Vite Environment Configuration Template
# Leave VITE_API_BASE_URL empty when served from the same origin (Docker /
# Flask single-service hosting or Vite dev proxy).
# Set to your HTTPS Flask API URL when deploying on Vercel / Netlify:
#   VITE_API_BASE_URL=https://mahjar-parents-api.onrender.com
# ==============================================================================
VITE_API_BASE_URL=
# Optional local dev proxy target for `npm run dev`
# VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:5000
