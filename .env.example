# ==============================================================================
# Mahjar Parents Backend — Environment Configuration Template
# Copy to `.env` for local development or set these keys in your free-tier
# hosting dashboard (Render / Railway / Fly.io / PythonAnywhere).
# NEVER commit real `.env` secrets to version control.
# ==============================================================================

# Environment mode: "development" or "production"
MAHJAR_ENV=development
MAHJAR_DEBUG=false

# Flask server bind settings (for local/WSGI entrypoints)
HOST=127.0.0.1
PORT=5000

# ------------------------------------------------------------------------------
# Cryptographic Secrets & Admin Authentication
# Generate a strong secret key:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate a scrypt/pbkdf2 password hash:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('YOUR_STRONG_PASSWORD'))"
# ------------------------------------------------------------------------------
MAHJAR_SECRET_KEY=replace-with-at-least-32-random-characters-before-production
# Optional comma-separated rotated secret keys for zero-downtime key rotation
MAHJAR_SECRET_KEY_FALLBACKS=

MAHJAR_ADMIN_USERNAME=admin
MAHJAR_ADMIN_PASSWORD_HASH=
# Avoid plaintext passwords in production; prefer MAHJAR_ADMIN_PASSWORD_HASH
MAHJAR_ADMIN_PASSWORD=
MAHJAR_ADMIN_TOKEN_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# HTTPS, Proxy Trust & Session Cookies (Free-Tier PaaS)
# Production defaults: ENFORCE_HTTPS=true, COOKIE_SECURE=true, TRUST_PROXY_COUNT=1
# ------------------------------------------------------------------------------
MAHJAR_ENFORCE_HTTPS=false
MAHJAR_HTTPS_EXEMPT_PATHS=/api/health
# Number of trusted reverse proxies terminating TLS (e.g., 1 on Render/Fly/Railway)
MAHJAR_TRUST_PROXY_COUNT=0
MAHJAR_HSTS_MAX_AGE=31536000
MAHJAR_HSTS_PRELOAD=false
MAHJAR_COOKIE_SECURE=false
MAHJAR_COOKIE_SAMESITE=Lax

# ------------------------------------------------------------------------------
# Strict CORS Rules
# Comma-separated exact origins (scheme://host[:port]). Wildcards (*) are rejected.
# Production requires https:// origins (e.g. https://mahjar-parents.vercel.app)
# ------------------------------------------------------------------------------
MAHJAR_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAHJAR_CORS_MAX_AGE=600
MAHJAR_CORS_ALLOW_INSECURE_ORIGINS=false

# ------------------------------------------------------------------------------
# In-Memory Rate Limiting (Zero-Budget Sliding Window)
# ------------------------------------------------------------------------------
MAHJAR_RATE_LIMIT_ENABLED=true
MAHJAR_RATE_LIMIT_AUTH_REQUESTS=10
MAHJAR_RATE_LIMIT_AUTH_WINDOW_SECONDS=60
MAHJAR_RATE_LIMIT_WRITE_REQUESTS=60
MAHJAR_RATE_LIMIT_WRITE_WINDOW_SECONDS=60
MAHJAR_RATE_LIMIT_UPLOAD_REQUESTS=20
MAHJAR_RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60
MAHJAR_RATE_LIMIT_PUBLIC_WRITE_REQUESTS=30
MAHJAR_RATE_LIMIT_PUBLIC_WRITE_WINDOW_SECONDS=60
MAHJAR_RATE_LIMIT_MAX_KEYS=10000

# ------------------------------------------------------------------------------
# Payload & Upload Guardrails
# ------------------------------------------------------------------------------
MAHJAR_MAX_CONTENT_LENGTH=6291456
MAHJAR_MAX_JSON_BODY_BYTES=65536
MAHJAR_MAX_JSON_DEPTH=8
MAHJAR_MAX_QUERY_PARAM_LENGTH=2048
# Production defaults to true (requires admin auth to upload images)
MAHJAR_REQUIRE_AUTH_FOR_MEDIA_UPLOAD=false

# Optional storage & free-tier packaging settings
# Unified persistent disk root (defaults DB + OpenCV uploads under one mount):
# MAHJAR_DATA_DIR=/var/data
# Storage backend: "auto", "json", or "sqlite" (recommended for concurrent writes)
MAHJAR_STORAGE_BACKEND=sqlite
# Optional SQLite connection URI (overrides MAHJAR_CMS_DATA_FILE):
# MAHJAR_DATABASE_URL=sqlite:////var/data/cms_data.sqlite3
# MAHJAR_CMS_DATA_FILE=/var/data/cms_data.sqlite3
# MAHJAR_MEDIA_UPLOAD_DIR=/var/data/uploads/images
# Free-tier OpenCV image storage quota in bytes (default 50 MiB = 52428800)
MAHJAR_MAX_MEDIA_STORAGE_BYTES=52428800

# Single-service mode: serve Vite React dist/ directly from Flask
MAHJAR_SERVE_FRONTEND=false
# MAHJAR_FRONTEND_DIST_DIR=/app/frontend/dist

# Gunicorn free-tier worker tuning (512 MB RAM budget)
WEB_CONCURRENCY=1
GUNICORN_THREADS=8
GUNICORN_BACKLOG=2048
GUNICORN_TIMEOUT=60
